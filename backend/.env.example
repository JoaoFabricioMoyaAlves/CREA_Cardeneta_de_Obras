# Copie para .env e preencha com valores reais. Nunca commitar o .env real.

POSTGRES_USER=caderneta_app
POSTGRES_PASSWORD=

MINIO_ROOT_USER=caderneta_minio
MINIO_ROOT_PASSWORD=
# Host publico do MinIO (usado tambem para gerar as URLs pre-assinadas das fotos)
MINIO_PUBLIC_ENDPOINT=storage-crea.joaofabricio.com

JWT_SIGNING_KEY=

# Senha extra exigida para cadastrar um novo Administrador pelo sistema
ADMIN_DEV_SECRET=

# Primeiro Administrador, criado automaticamente na primeira subida do backend
BOOTSTRAP_ADMIN_CPF=
BOOTSTRAP_ADMIN_SENHA=
BOOTSTRAP_ADMIN_NOME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_TELEFONE=

# E-mail (SMTP). Deixe SMTP_HOST vazio para desligar o envio.
# Gmail: use uma SENHA DE APP (conta com verificacao em 2 etapas), nunca a
# senha normal. Porta 587 + StartTls: a 465 e bloqueada pela Hetzner.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SEGURANCA=StartTls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
